# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OpenClaw Integration Credentials
# Configure OPENCLAW_API_KEYS as a JSON array of allowed keys and their scopes
# Example JSON: [{"id":"key_davi_agent","secret_hash":"<SHA256_HASH_OF_YOUR_SECRET_KEY>","scopes":["read","schedule","cancel"]}]
OPENCLAW_API_KEYS="[{\"id\":\"key_davi_master\",\"secret_hash\":\"<SHA256_HASH_OF_YOUR_SECRET_KEY>\",\"scopes\":[\"read\",\"schedule\",\"cancel\"]}]"

# Webhook WhatsApp Meta Credentials
WHATSAPP_VERIFY_TOKEN="<YOUR_WHATSAPP_VERIFY_TOKEN_PLACEHOLDER>"
WHATSAPP_APP_SECRET="<YOUR_WHATSAPP_APP_SECRET_PLACEHOLDER>"

# Cron Cleanup Secret
CRON_SECRET="<YOUR_CRON_SECRET_PLACEHOLDER>"

# MCP Server Settings
OTICA_API_BASE_URL="http://localhost:3000/api/openclaw/v1"
OPENCLAW_RAW_API_KEY="<YOUR_RAW_SECRET_KEY_PLACEHOLDER>"
